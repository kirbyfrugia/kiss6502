#############################################################
# direwolf.conf.template - kisstty dev/test
#
# Template for scenario-runner, which generates the direwolf.conf it runs.
# See tests/README.md.
#
# These are substitution anchors and have to stay verbatim:
#
#   %%KISSPORT%%    becomes the KISS TCP port in use.
#   %%SERIALKISS%%  becomes "SERIALKISS <device>", or is dropped for TCP
#                   KISS only.
#   MYCALL NOCALL   becomes the scenario's mycall. Putting a real callsign
#                   here instead breaks the substitution silently.
#############################################################

# RX from WAV via stdin; TX to system audio (PipeWire/pulse)
ADEVICE stdin default

CHANNEL 0

MYCALL NOCALL

MODEM 1200

# KISS TCP - kisstty connects here
KISSPORT %%KISSPORT%%

# KISS over a serial device
%%SERIALKISS%%

# AGW port - for tools like YAAC if needed
AGWPORT 8000

# No beaconing in dev
# PBEACON ...

# Suppress Avahi/DNS-SD spam
DNSSD 0

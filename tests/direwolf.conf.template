#############################################################
# direwolf.conf.template - kisstty dev/test
#
# Template for scenario-runner, which generates the direwolf.conf it runs.
# See tests/README.md.
#
# Two lines below are substitution anchors and have to stay verbatim:
#
#   %%SERIALKISS%%  becomes "SERIALKISS <device>" from the scenario's serial
#                   field, or is dropped for TCP KISS only.
#   MYCALL NOCALL   becomes the scenario's mycall. Putting a real callsign
#                   here instead breaks the substitution silently.
#############################################################

# RX from WAV via stdin; TX to system audio (PipeWire/pulse)
ADEVICE stdin pulse

CHANNEL 0

MYCALL NOCALL

MODEM 1200

# KISS TCP - kisstty connects here
KISSPORT 8001

# KISS over a serial device - filled in from the scenario's serial field
%%SERIALKISS%%

# AGW port - for tools like YAAC if needed
AGWPORT 8000

# No beaconing in dev
# PBEACON ...

# Suppress Avahi/DNS-SD spam
DNSSD 0
